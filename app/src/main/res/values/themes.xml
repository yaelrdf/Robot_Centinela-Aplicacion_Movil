<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de ventana. La interfaz se dibuja con Compose (ui/theme); este tema solo evita un
         destello de color al arrancar y deja las barras del sistema transparentes (edge-to-edge). -->
    <style name="Theme.Centinela" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/centinela_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Pantalla de inicio del sistema (Manual de identidad, pág. 27): fondo Black Blue con el isotipo.
         Al terminar, la actividad pasa a Theme.Centinela (postSplashScreenTheme). -->
    <style name="Theme.Centinela.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/visor_black_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_isotipo</item>
        <item name="postSplashScreenTheme">@style/Theme.Centinela</item>
    </style>
</resources>
