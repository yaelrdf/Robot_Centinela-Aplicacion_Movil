digraph G {
 rankdir=TB;

graph [fontname="Poppins", fontsize=10, fontcolor="#041839", bgcolor="white", pad=0.15, size="6.54,9"];
node  [fontname="Poppins", fontsize=9.5, fontcolor="#041839", color="#2D4059", style="rounded,filled",
       fillcolor="#E7ECF3", shape=box, penwidth=1.1, margin="0.14,0.07"];
edge  [fontname="Poppins", fontsize=8.5, fontcolor="#2D4059", color="#2D4059", arrowsize=0.75, penwidth=1.05];

nodesep=0.18; ranksep=0.42; edge [arrowhead=crow, arrowtail=none, dir=forward, color="#2D4059"];
homes [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>homes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · name · timezone</FONT></TD></TR></TABLE>>];
memberships [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>memberships</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">home_id · user_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">role · status</FONT></TD></TR></TABLE>>];
robots [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>robots</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · home_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">public_code · status</FONT></TD></TR></TABLE>>];
devices [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>devices</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · robot_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">firmware_version</FONT></TD></TR></TABLE>>];
device_sessions [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>device_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · device_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">boot_id</FONT></TD></TR></TABLE>>];
map_versions [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2D4059" BGCOLOR="white"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>map_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · home_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">version_no</FONT></TD></TR></TABLE>>];
missions [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>missions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · robot_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">map_version_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">status · started_at</FONT></TD></TR></TABLE>>];
telemetry_frames [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>telemetry_frames</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · robot_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">device_session_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">mission_id · sequence</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">captured_at · received_at</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">stream_version</FONT></TD></TR></TABLE>>];
channels [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>channels</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · robot_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">channel_key</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">metric_type · unit_code</FONT></TD></TR></TABLE>>];
sensor_readings [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>sensor_readings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">frame_id · channel_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">value | boolean_value</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">quality</FONT></TD></TR></TABLE>>];
frame_poses [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>frame_poses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">frame_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">map_version_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">x_m · y_m · theta_rad</FONT></TD></TR></TABLE>>];
robot_states [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>robot_states</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">frame_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">reported_state</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">motors_active</FONT></TD></TR></TABLE>>];
battery_readings [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>battery_readings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">frame_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">voltage_v · soc_pct</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">method_code</FONT></TD></TR></TABLE>>];
alerts [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#FF5722" BGCOLOR="#FFE9E1"><TR><TD BGCOLOR="#2D4059"><FONT COLOR="white" POINT-SIZE="9"><B>alerts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">id · robot_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">type · severity</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="8">state · origin</FONT></TD></TR></TABLE>>];
    homes -> memberships; homes -> robots; homes -> map_versions;
    robots -> devices; devices -> device_sessions; robots -> missions; map_versions -> missions;
    robots -> telemetry_frames; device_sessions -> telemetry_frames; missions -> telemetry_frames;
    robots -> channels; robots -> alerts;
    telemetry_frames -> sensor_readings; channels -> sensor_readings;
    telemetry_frames -> frame_poses; telemetry_frames -> robot_states; telemetry_frames -> battery_readings;
    map_versions -> frame_poses;
    
}
