digraph G {
 rankdir=TB;

graph [fontname="Poppins", fontsize=10, fontcolor="#041839", bgcolor="white", pad=0.15, size="6.54,9"];
node  [fontname="Poppins", fontsize=9.5, fontcolor="#041839", color="#2D4059", style="rounded,filled",
       fillcolor="#E7ECF3", shape=box, penwidth=1.1, margin="0.14,0.07"];
edge  [fontname="Poppins", fontsize=8.5, fontcolor="#2D4059", color="#2D4059", arrowsize=0.75, penwidth=1.05];

nodesep=0.25; ranksep=0.5;

    node [shape=ellipse, margin="0.12,0.06"];
    Idle [fillcolor="white"];
    Connecting; Reconciling; Live [fillcolor="#B5D0A2"];
    Offline [fillcolor="#F7B32D"]; Error [fillcolor="#F4B6B6"]; Stopped [fillcolor="white"];
    Idle -> Connecting [label="start()\nsin cursor"];
    Connecting -> Live [label="sincronizó"];
    Live -> Reconciling [label="aviso o\n30 s"];
    Reconciling -> Live [label="sincronizó"];
    Live -> Offline [label="Interrupted"];
    Connecting -> Offline [label="Interrupted"];
    Offline -> Reconciling [label="Subscribed"];
    Live -> Error [label="falla la consulta"];
    Error -> Reconciling [label="siguiente aviso\no 30 s"];
    Live -> Stopped [label="stop()\n(desde cualquier estado)"];
    Stopped -> Reconciling [label="start()\ncon cursor", style=dashed];
    
}
